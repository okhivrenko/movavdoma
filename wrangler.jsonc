{
  "name": "movayakvdoma",
  "main": "worker.js",
  "compatibility_date": "2026-07-31",
  "vars": {
    "BOT_BRAND_NAME": "MovaYakVDoma",
    "PUBLIC_WORKER_URL": "https://movayakvdoma.com",
    "MONOBANK_JAR_SEND_ID": "9vp8W5V9nQ"
  },
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"]
  },
  "routes": [
    {
      "pattern": "movayakvdoma.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vocab-words-db",
      "database_id": "62ded422-e125-42b3-99de-a86fdcf5f9f8",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "DAILY_WORD_INTERACTIVE_JOBS", "queue": "movayakvdoma-daily-word-interactive" },
      { "binding": "DAILY_WORD_PREFETCH_JOBS", "queue": "movayakvdoma-daily-word-prefetch" }
    ],
    "consumers": [
      { "queue": "movayakvdoma-daily-word-interactive", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 3, "retry_delay": 15, "dead_letter_queue": "movayakvdoma-daily-word-interactive-dlq" },
      { "queue": "movayakvdoma-daily-word-prefetch", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 1, "retry_delay": 60, "dead_letter_queue": "movayakvdoma-daily-word-prefetch-dlq" }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
